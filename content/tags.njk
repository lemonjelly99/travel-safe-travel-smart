---
title: Tags
description: "Browse all news and updates by topic."
kicker: News & Updates
layout: layouts/page-full.njk
primaryBtn: { label: "News & Updates", url: "news.njk" }
---

{% from "components/sectionHeader/macro.njk" import sectionHeader %}
{% from "components/tagCloud/macro.njk" import tagCloud %}
{% from "components/newsCardList/macro.njk" import newsCardList %}
{% from "components/button/macro.njk" import button %}

{% set tags = collections | getKeys | filterTagList | sortAlphabetically %}


{# ---- Tag Cloud ---- #}

{% if tags.length > 0 %}
<section class="o-section">
  <div class="o-container o-container--lg">


    {{ sectionHeader({
      kicker: "Browse by topic",
      title: "All Tags",
      description: "Select a tag to see all related news and updates."
    }) }}

    {% set tagCloudTags = [] %}

    {%- for tag in tags %}
      {% set url = tag | slugify %}
      {% set count = collections[tag] | length %}
      {% set _ = tagCloudTags.push({ text: tag, count: count, url: "/tags/" ~ url ~ "/" }) %}
    {%- endfor %}

    {{ tagCloud({ tags: tagCloudTags }) }}


  </div>
</section>
{% endif %}


{# ---- Latest across all tags ---- #}

{% set posts = collections.posts | reverse  %}

{% if posts.length > 0 %}
<section class="o-section u-bg-cream">
  <div class="o-container">


    {{ sectionHeader({
      kicker: "Latest",
      title: "Recent Updates"
    }) }}
  

    {% set postsList = posts.slice(0,3) %}
    {{ newsCardList({posts: postsList}) }}

    <div class="u-text-center u-mt-8">
      {{ button({ label: "View all news", url: "news.njk", style: "outline" }) }}
    </div>

  </div>
</section>
{% endif %}
