---
title: What we do
description: "Community Safety Managers deliver practical support and coordinated safety initiatives at the heart of local communities."
kicker: Our Work
lastUpdated: 2026-03-26
layout: layouts/page-full.njk
eleventyNavigation:
  key: What we do
  order: 3
primaryBtn:
  label: Find your local Community Safety Manager
  url: /contact/#csm-finder-heading
---

{# ---- What we do content: see _data/whatWeDo.js ---- #}


{% from "components/feature/macro.njk" import feature as featureMacro %}
{% from "components/button/macro.njk" import button %}
{% from "components/tag/macro.njk" import tag as tag_macro %}
{% from "components/sectionHeader/macro.njk" import sectionHeader %}

{# ---- see _data/whatWeDo.js ---- #}

{%- for item in whatWeDo %}
  {% set indexLoop = loop.index %}
  {% if loop.index < 10 %}
    {% set indexLoop = '0' + loop.index %}
  {% endif %}

  {% set mainContent %}
 
     {{ sectionHeader({
        title: item.title,
        description: item.description | safe,
        kicker: indexLoop
      }) }}
    {# <h2>{{ item.title }}</h2> #}
    {{ item.description | safe }}

    {% if item.buttons %} 
    {% for btn in item.buttons %}
      {{ button({ label: btn.label, url: btn.url, style: btn.style }) }}
    {% endfor %}
    {% endif %}

    {% if item.cluster %}
      <div class="o-cluster u-mt-4">
        {% for tag in item.cluster %}
          {{tag_macro({text: tag, type: "primary"}) }}
        {% endfor %}
      </div>
    {% endif %}
  {% endset %}

  {% set secondaryContent %}
    {% if item.features %}
      <div class="o-stack">
        {% for feature in item.features %}
        {{ featureMacro(feature) }}
        {% endfor %}
      </div>
    {% endif %}

    {% if item.quotes %}
      <div class="c-quotes">
        {% for quote in item.quotes %}
          <blockquote class="c-quote">
            <p>{{ quote.text }}</p>
            <footer>&mdash; {{ quote.credit }}</footer>
          </blockquote>
        {% endfor %}
      </div>
    {% endif %}
  {% endset %}

  <section id="{{ item.slug }} " class="o-section {% if loop.index is even %}u-bg-cream{% endif %}">
    <div class="o-container o-container--lg">
      {% if item.features.length > 0 or item.quotes.length > 0 %}
      <div class="o-sidebar">
        <div>
          {{ mainContent | safe }}
        </div>
        <div>
          {{ secondaryContent | safe }}
        </div>
      </div>
      {% else %}
        {{ mainContent | safe }}
        {{ secondaryContent | safe}}
      {% endif %}
    </div>
  </section>

{%- endfor %}

